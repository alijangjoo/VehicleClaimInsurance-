{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ElasticApm": {
    "ServerUrl": "http://localhost:8200",
    "ServiceName": "yarp-api-gateway",
    "ServiceVersion": "1.0.0",
    "Environment": "development",
    "TransactionSampleRate": 1.0,
    "CaptureHeaders": true,
    "CaptureBody": "all",
    "LogLevel": "Debug",
    "Enabled": true
  },
  "ReverseProxy": {
    "Routes": {
      "core-service-route": {
        "ClusterId": "core-service-cluster",
        "Match": {
          "Path": "/api/CoreService/{**catch-all}"
        },
        //"Transforms": [
        //  {
        //    "PathPattern": "{**catch-all}"
        //  }
        //],
        "Order": 1
        //"AuthorizationPolicy": "Authenticated"
      },
      "user-service-route": {
        "ClusterId": "user-service-cluster",
        "Match": {
          "Path": "/api/UserService/{**catch-all}"
        },
        //"Transforms": [
        //  {
        //    "PathPattern": "{**catch-all}"
        //  }
        //],
        "Order": 2
        //"AuthorizationPolicy": "Authenticated"
      }
    },
    "Clusters": {
      "core-service-cluster": {
        "Destinations": {
          "core-service-destination": {
            "Address": "https://localhost:7200/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "ReactivationPeriod": "00:02:00"
          }
        }
      },
      "user-service-cluster": {
        "Destinations": {
          "user-service-destination": {
            "Address": "https://localhost:7209/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "ReactivationPeriod": "00:02:00"
          }
        }
      }
    }
  }
}
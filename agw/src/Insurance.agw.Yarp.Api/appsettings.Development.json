{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Debug"
    }
  },
  "ReverseProxy": {
    "Clusters": {
      "service1-cluster": {
        "Destinations": {
          "service1-destination": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "service2-cluster": {
        "Destinations": {
          "service2-destination": {
            "Address": "http://localhost:5002/"
          }
        }
      }
    }
  }
}
